# Copy to .env (never commit .env). Real values live in CI secrets and engineers' machines.
# Pass build-time values with --dart-define. Backend choice is still open, see docs/decisions/.

# Switch placeholders on (UI runs on mocks). Used by the designer and the web preview.
USE_MOCKS=true

# Backend (names depend on the decision in docs/decisions/)
API_BASE_URL=
REALTIME_URL=

# Zeego Cloud (calls)
ZEGO_APP_ID=
# ZEGO server secret / token generation stays on the server. Never ship it in the app.

# RevenueCat (public SDK keys only)
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=

# Push
# FCM / APNs configuration files are added per platform and are not committed.

# Ads (provider TBD)
ADS_APP_ID_IOS=
ADS_APP_ID_ANDROID=
