# Copy to .env.local (never commit it). Vite only exposes names that start with VITE_.
# Leave both empty to run fully on mocks; A/B results are then kept on this device only.

# Supabase project for A/B results (see docs/AB_TESTING.md). The anon key is public by
# design: the database only allows inserting events and reading aggregate results.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
